# --- Banco de dados (Supabase Postgres) ---
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (porta 6543).
# Use o pooler (não a conexão direta) — obrigatório em ambiente serverless (Vercel).
DATABASE_URL=

# --- Supabase Auth (login do Admin/Super Admin) ---
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email do usuário dono (liberado como Super Admin). Deve bater com o email
# usado para criar o usuário no Supabase Auth (Authentication > Users).
OWNER_EMAIL=

# Chave para criptografar credenciais salvas (Mercado Pago, WhatsApp/SMS) no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=

# --- Mercado Pago (OAuth Connect) ---
# https://www.mercadopago.com.br/developers/panel/app — crie uma Aplicação.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# URL pública do seu app + /api/mercadopago/oauth-callback
MP_REDIRECT_URI=https://SEU-DOMINIO/api/mercadopago/oauth-callback

# --- Uber Direct (entrega automática) ---
# https://developer.uber.com/docs/deliveries/overview — cadastro self-service.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
# Endereço de retirada (cozinha da marmitaria), formato completo com cidade/UF/CEP.
PICKUP_ADDRESS=

NODE_ENV=development
PORT=3000
