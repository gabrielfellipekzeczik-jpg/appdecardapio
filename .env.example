# ============================================================
# App de Cardápio — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env com valores reais.
# ============================================================

# --- Supabase Auth (login de Admin/Super Admin) ---
# Supabase > Project Settings > API Keys
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# --- Supabase Server (backend / funções serverless) ---
# Supabase > Project Settings > API Keys > service_role (NUNCA exponha no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# --- Supabase JWT Secret (verificação de tokens no backend) ---
# Supabase > Project Settings > JWT Keys > Legacy JWT Secret
SUPABASE_JWT_SECRET=seu-jwt-secret-aqui

# --- Email do dono da PLATAFORMA (Super Admin) ---
# Deve ser o mesmo email usado para criar a conta no Supabase Auth.
OWNER_EMAIL=seuemail@exemplo.com

# --- Chave de criptografia para credenciais de integrações ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Exemplo gerado: sS34mAKeEPQJfkXvgnduSg5sotjDquH56fu6u9XoXIc=
INTEGRATIONS_ENCRYPTION_KEY=

# --- Mercado Pago (aplicação OAuth da plataforma) ---
# Crie UMA Aplicação em https://www.mercadopago.com.br/developers/panel/app
# Cada empresa conecta a própria conta através dela via OAuth.
MP_CLIENT_ID=seu-client-id-aqui
MP_CLIENT_SECRET=seu-client-secret-aqui
# URL pública do deploy + /api/mercadopago/oauth-callback
MP_REDIRECT_URI=https://SEU-DOMINIO.vercel.app/api/mercadopago/oauth-callback

# Percentual de taxa retido pela plataforma em cada pagamento via MP (padrão 5)
PLATFORM_FEE_PERCENT=5

# --- Ambiente ---
NODE_ENV=development
PORT=3000

# --- Credenciais de entrega (Uber Direct / Lalamove / motoboy) ---
# NÃO ficam em env vars — cada empresa cadastra as suas em
# Integrações (/:slug/admin/integracoes) e ficam criptografadas no banco.
