# --- Banco de dados (Supabase Postgres) ---
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (porta 6543).
# Use o pooler (não a conexão direta) — obrigatório em ambiente serverless (Vercel).
DATABASE_URL=

# --- Supabase Auth (login de Admin/Super Admin) ---
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email do dono da PLATAFORMA (não de uma empresa específica). Libera o
# Super Admin (lista de empresas + receita de taxas). Deve bater com o email
# usado pra criar o usuário no Supabase Auth (Authentication > Users).
OWNER_EMAIL=

# Chave para criptografar credenciais salvas por empresa (Mercado Pago, Uber
# Direct, Lalamove, WhatsApp/SMS) no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=

# --- Mercado Pago (aplicação OAuth da plataforma) ---
# https://www.mercadopago.com.br/developers/panel/app — crie UMA Aplicação
# (sua, da plataforma). Cada empresa conecta a própria conta através dela.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# URL pública do seu app + /api/mercadopago/oauth-callback
MP_REDIRECT_URI=https://SEU-DOMINIO/api/mercadopago/oauth-callback
# Percentual retido em cada pedido via Mercado Pago "application_fee" (padrão 5).
PLATFORM_FEE_PERCENT=5

# Credenciais de Uber Direct / Lalamove / motoboy próprio NÃO ficam em env var —
# cada empresa cadastra as suas em Integrações (/:slug/admin/integracoes).

NODE_ENV=development
PORT=3000
