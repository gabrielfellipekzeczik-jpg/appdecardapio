{
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/mercadopago/oauth-callback(.*)", "destination": "/api/trpc" },
    { "source": "/api/webhooks/mercadopago(.*)", "destination": "/api/trpc" },
    { "source": "/api/mercadopago-oauth", "destination": "/api/mercadopago-oauth" },
    { "source": "/api/trpc/(.*)", "destination": "/api/trpc" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
